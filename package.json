{
  "name": "regionle",
  "private": true,
  "version": "1.39.1",
  "homepage": "https://diegosb72.github.io/regionle/",
  "description": "Regionle ∞ — juego de geografía ilimitado para aprender países y regiones del mundo",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/pwa/build.mjs dist && node scripts/budget.mjs dist",
    "build:pages": "tsc --noEmit && vite build --outDir docs --emptyOutDir && node scripts/pwa/build.mjs docs && node scripts/budget.mjs docs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "data:fetch": "node scripts/data/fetch.mjs",
    "data:build": "node --max-old-space-size=3200 scripts/data/build.mjs",
    "data:population": "node scripts/data/population.mjs",
    "data:physical": "node scripts/data/physical.mjs",
    "data:figures": "node scripts/data/figures.mjs",
    "data:check": "node scripts/data/check.mjs",
    "data:outside": "node scripts/data/outside.mjs",
    "data": "npm run data:fetch && npm run data:build && npm run data:population && npm run data:physical && npm run data:figures",
    "typeins": "node scripts/typeins/build.mjs",
    "social": "node scripts/social/build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "d3-ease": "^3.0.2",
    "d3-geo": "^3.1.2",
    "d3-interpolate": "^3.0.2",
    "d3-selection": "^3.0.1",
    "d3-transition": "^3.0.2",
    "d3-zoom": "^3.0.1",
    "flag-icons": "^7.6.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/d3-ease": "^3.0.2",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.3.0",
    "d3-geo-projection": "^4.0.0",
    "jsdom": "^31.0.1",
    "jsqr": "^1.4.0",
    "polylabel": "^2.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
